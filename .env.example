# Family Market — environment variables (copy to .env and fill in real values)

# REQUIRED — PostgreSQL connection string.
# Production database is hosted on Neon (https://neon.tech).
# Format: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# REQUIRED — Secret used to sign admin session tokens (JWT).
# Generate one locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# REQUIRED FOR MEDIA UPLOADS — Vercel Blob read/write token.
# Create a Blob store in the Vercel dashboard (Storage → Blob), then copy the
# "BLOB_READ_WRITE_TOKEN" value here. Uploads are disabled while this is empty.
BLOB_READ_WRITE_TOKEN=""
# Optional when the store uses OIDC auth on Vercel:
# BLOB_STORE_ID=""

# REQUIRED — First admin account, created with: npm run create-admin
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-to-a-strong-password"