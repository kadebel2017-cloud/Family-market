// Family Market — Prisma schema
// Database: PostgreSQL (Neon in production)
// Convention: content fields exist in French (fr) and Arabic (ar).
// No invented business data — never seed fake products or store info.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum AdminRole {
  ADMIN
}

enum MediaType {
  image
  video
}

enum MediaCategory {
  PRODUCT
  CATEGORY
  PROMOTION
  HERO
  STORE
  LOGO
  OTHER
}

enum PromotionType {
  PRODUCT_DISCOUNT
  PACK
}

enum DeliveryType {
  HOME
  OFFICE
  FREE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ---------------------------------------------------------------
// Admin
// ---------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------

model Category {
  id            String    @id @default(cuid())
  nameFr        String
  nameAr        String
  slug          String    @unique
  descriptionFr String?
  descriptionAr String?
  image         String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id            String             @id @default(cuid())
  nameFr        String
  nameAr        String
  slug          String             @unique
  descriptionFr String?
  descriptionAr String?
  size          String
  // Optional barcode. Unique when present — PostgreSQL unique
  // constraints ignore NULL, so products without a barcode are unaffected.
  sku           String?          @unique
  price         Decimal            @db.Decimal(10, 2)
  salePrice     Decimal?           @db.Decimal(10, 2)
  image         String?
  isAvailable   Boolean            @default(true)
  categoryId    String
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  promotions    PromotionProduct[]
  orderItems    OrderItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([categoryId, isAvailable])
}

// ---------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------

model Promotion {
  id            String             @id @default(cuid())
  titleFr       String
  titleAr       String
  descriptionFr String?
  descriptionAr String?
  image         String?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean            @default(true)
  // Offer type. Existing rows default to PRODUCT_DISCOUNT so legacy
  // promotions keep working unchanged.
  type          PromotionType      @default(PRODUCT_DISCOUNT)
  // Total promotional price for PACK offers. Null for PRODUCT_DISCOUNT.
  // Product.price is never modified — the pack price lives here.
  packPrice     Decimal?           @db.Decimal(10, 2)
  // Whether to display the "Économie" savings row on the public PACK page.
  // Defaults to false so existing promotions keep today's hidden behavior
  // until the admin explicitly enables it.
  showSavings   Boolean            @default(false)
  products      PromotionProduct[]
  slides        PromotionSlide[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive, startDate, endDate])
}

// Join table linking promotions to products. Allows promotions to target
// specific products without a schema rewrite in a later phase.
model PromotionProduct {
  promotionId String
  productId   String
  // Quantity of this product inside a PACK (always 1 for PRODUCT_DISCOUNT).
  quantity    Int      @default(1)
  // Per-product promotional price for PRODUCT_DISCOUNT offers.
  // Null = no special price (normal Product.price applies).
  promoPrice  Decimal? @db.Decimal(10, 2)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------
// Store settings
// ---------------------------------------------------------------

// Single settings record (only one row may exist — enforced by convention:
// the app always reads/writes the row with id "default").
model StoreSettings {
  id                  String   @id @default("default")
  storeNameFr         String
  storeNameAr         String
  phone               String?
  whatsapp            String?
  addressFr           String?
  addressAr           String?
  facebookUrl         String?
  instagramUrl        String?
  tiktokUrl           String?
  googleMapsUrl       String?
  logoImage           String?
  heroMedia           String?
  // Public "À propos" page content, edited from Admin → Paramètres.
  // All optional: the public page stays clean when nothing is set.
  aboutTitleFr        String?
  aboutTitleAr        String?
  aboutDescriptionFr  String?
  aboutDescriptionAr  String?
  openingTime         String
  closingTime         String
  isOpenAutomatically Boolean  @default(true)
  findStoreEnabled    Boolean  @default(false)
  findStoreTitle      String?
  findStoreVideoUrl   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------
// Delivery & orders (COD checkout, Saada-style flow)
// ---------------------------------------------------------------

// Delivery fees per wilaya, edited in Admin → Livraison.
// Only wilayas with an active row can be ordered — no invented prices.
model WilayaPrice {
  id                  String   @id @default(cuid())
  wilayaCode          String   @unique
  wilayaName          String
  homePrice           Decimal  @db.Decimal(10, 2)
  officePrice         Decimal  @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive])
}

// Global delivery-service switch, controlled in Admin → Livraison.
// Single row (id "default"). ON = current behavior, OFF = delivery
// fields are shown disabled at checkout and orders are refused.
model DeliverySettings {
  id              String   @id @default("default")
  deliveryEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Free-delivery rule, fully controlled in Admin → Livraison.
// Single row (id "default"). When enabled and the order subtotal reaches
// the threshold, checkout offers a locked free-delivery mode for the
// configured wilaya / commune / district. All values editable —
// nothing is hardcoded in the app code.
model FreeDeliveryRule {
  id            String   @id @default("default")
  isEnabled     Boolean  @default(false)
  threshold     Decimal  @db.Decimal(10, 2)
  wilayaCode    String
  wilayaName    String
  commune       String
  district      String
  // Promotional banner shown at the top of every public page.
  // Only effective while the rule itself is enabled.
  bannerEnabled Boolean  @default(false)
  bannerTextFr  String?
  bannerTextAr  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique
  customerName   String
  phone          String
  wilayaCode     String
  wilayaName     String
  commune        String
  address        String?
  deliveryType   DeliveryType @default(HOME)
  notes          String?
  subtotal       Decimal      @db.Decimal(10, 2)
  deliveryFee    Decimal      @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  status         OrderStatus  @default(NEW)
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([orderNumber])
}

// Product snapshots (names + unit price) are stored so order history
// stays intact even if the product is later edited or deleted
// (productId uses SetNull, never Cascade).
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameFr String
  productNameAr String
  unitPrice     Decimal  @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal  @db.Decimal(10, 2)
  // Pack snapshot: when the line comes from a PACK promotion, these keep
  // the pack identity so admin can group the included products.
  // Null for loose (non-pack) lines. The promotion itself may be deleted.
  promotionId      String?
  promotionTitleFr String?
  promotionTitleAr String?

  @@index([orderId])
}

// ---------------------------------------------------------------
// Hero slideshow
// ---------------------------------------------------------------

// Ordered usage of MediaAsset records for the homepage hero.
// The file itself stays in MediaAsset — HeroSlide is only the
// usage/order relationship. Unlimited HeroSlide rows may exist,
// but at most 10 may have isActive = true (enforced in app logic).
model HeroSlide {
  id        String     @id @default(cuid())
  mediaId   String     @unique
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------
// Promotion media slideshow
// ---------------------------------------------------------------

// Ordered usage of MediaAsset records for a single Promotion.
// Mirrors HeroSlide architecture: file stays in MediaAsset,
// PromotionSlide is usage/order. Unlimited rows, max 10 active
// per promotion (enforced in app logic). Additive only.
model PromotionSlide {
  id          String     @id @default(cuid())
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  mediaId     String
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([promotionId, mediaId])
  @@index([promotionId, isActive, sortOrder])
}

// ---------------------------------------------------------------
// Media
// ---------------------------------------------------------------

model MediaAsset {
  id              String           @id @default(cuid())
  name            String
  url             String
  type            MediaType
  mimeType        String?
  size            Int?
  category        MediaCategory    @default(OTHER)
  altFr           String?
  altAr           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  heroSlides      HeroSlide[]
  promotionSlides PromotionSlide[]

  @@index([type])
  @@index([category])
  @@index([createdAt])
}
